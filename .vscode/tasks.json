{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "make -j$(sysctl -n hw.ncpu)",
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Using GNU make with CPU core count"
        },
        {
            "label": "Flash via Daplink",
            "type": "shell",
            "command": "make download_daplink",
            "problemMatcher": ["$gcc"],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Flashes firmware using Daplink",
            "dependsOn": "Build"
        },
        {
            "label": "Flash via Jlink",
            "type": "shell",
            "command": "make download_jlink",
            "problemMatcher": ["$gcc"],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Flashes firmware using Jlink",
            "dependsOn": "Build"
        },
        {
            "label": "Start OpenOCD Server",
            "type": "shell",
            "command": "openocd -f /opt/homebrew/opt/open-ocd/share/openocd/scripts/interface/cmsis-dap.cfg -f /opt/homebrew/opt/open-ocd/share/openocd/scripts/target/stm32f4x.cfg",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Info : .+ Listening on port \\d+ for gdb connections",
                    "endsPattern": "Info : .+ accepting 'telnet' connection"
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Starts OpenOCD server for debugging"
        },
        {
            "label": "RTT Log Viewer",
            "type": "shell",
            "command": "telnet localhost 4444",
            "problemMatcher": [],
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Connects to OpenOCD RTT console",
            "dependsOn": "Start OpenOCD Server"
        }
    ]
}