{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DAPlink (macOS)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "servertype": "openocd",
            "configFiles": [
                "/opt/homebrew/opt/open-ocd/share/openocd/scripts/interface/cmsis-dap.cfg",
                "/opt/homebrew/opt/open-ocd/share/openocd/scripts/target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "rtos": "FreeRTOS",
            "preLaunchTask": "Build",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb",
            "searchDir": [
                "/opt/homebrew/opt/open-ocd/share/openocd/scripts"
            ],
            "serverArgs": [
                "-d2"
            ],
            "showDevDebugOutput": "raw"
        },
        {
            "name": "Jlink (macOS)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F407IG",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "servertype": "jlink",
            "interface": "swd",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "rtos": "FreeRTOS",
            "preLaunchTask": "Build",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb"
        },
        {
            "name": "DAP-attach (macOS)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "request": "attach",
            "type": "cortex-debug",
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "servertype": "openocd",
            "configFiles": [
                "/opt/homebrew/opt/open-ocd/share/openocd/scripts/interface/cmsis-dap.cfg",
                "/opt/homebrew/opt/open-ocd/share/openocd/scripts/target/stm32f4x.cfg"
            ],
            "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb",
            "searchDir": [
                "/opt/homebrew/opt/open-ocd/share/openocd/scripts"
            ]
        }
    ]
}